<?xml version="1.0" encoding="UTF-8"?>
<data xmlns="http://www.woltlab.com" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.woltlab.com http://www.woltlab.com/XSD/6.0/eventListener.xsd">
	<import>
		<!-- No self-reply: reject replies from the thread author on an enabled board. -->
		<eventlistener name="preventSelfReply">
			<eventclassname>wbb\data\post\PostAction</eventclassname>
			<eventname>validateAction</eventname>
			<listenerclassname>wcf\system\event\listener\GwPreventSelfReplyListener</listenerclassname>
			<environment>user</environment>
		</eventlistener>

		<!-- Bump: expose the button state on the thread page. -->
		<eventlistener name="threadBumpDisplay">
			<eventclassname>wbb\page\ThreadPage</eventclassname>
			<eventname>assignVariables</eventname>
			<listenerclassname>wcf\system\event\listener\GwThreadBumpDisplayListener</listenerclassname>
			<environment>user</environment>
		</eventlistener>

		<!-- Squash: filter the post list (before count + read) and expose the squash UI. -->
		<eventlistener name="threadSquashFilter">
			<eventclassname>wbb\page\ThreadPage</eventclassname>
			<eventname>afterInitObjectList</eventname>
			<listenerclassname>wcf\system\event\listener\GwThreadSquashFilterListener</listenerclassname>
			<environment>user</environment>
		</eventlistener>
		<eventlistener name="threadSquashDisplay">
			<eventclassname>wbb\page\ThreadPage</eventclassname>
			<eventname>assignVariables</eventname>
			<listenerclassname>wcf\system\event\listener\GwThreadSquashDisplayListener</listenerclassname>
			<environment>user</environment>
		</eventlistener>

		<!-- Per-board settings on the board ACP form (read / save / prefill / display). -->
		<eventlistener name="boardSettingsRead">
			<eventclassname>wbb\acp\form\BoardAddForm</eventclassname>
			<eventname>readFormParameters</eventname>
			<listenerclassname>wcf\system\event\listener\GwBoardSelfReplyOptionListener</listenerclassname>
			<environment>admin</environment>
			<inherit>1</inherit>
		</eventlistener>
		<eventlistener name="boardSettingsSave">
			<eventclassname>wbb\acp\form\BoardAddForm</eventclassname>
			<eventname>save</eventname>
			<listenerclassname>wcf\system\event\listener\GwBoardSelfReplyOptionListener</listenerclassname>
			<environment>admin</environment>
			<inherit>1</inherit>
		</eventlistener>
		<eventlistener name="boardSettingsAssign">
			<eventclassname>wbb\acp\form\BoardAddForm</eventclassname>
			<eventname>assignVariables</eventname>
			<listenerclassname>wcf\system\event\listener\GwBoardSelfReplyOptionListener</listenerclassname>
			<environment>admin</environment>
			<inherit>1</inherit>
		</eventlistener>
		<eventlistener name="boardSettingsReadData">
			<eventclassname>wbb\acp\form\BoardEditForm</eventclassname>
			<eventname>readData</eventname>
			<listenerclassname>wcf\system\event\listener\GwBoardSelfReplyOptionListener</listenerclassname>
			<environment>admin</environment>
		</eventlistener>
	</import>
</data>
