<?xml version="1.0" encoding="UTF-8"?>
<package name="com.gwlegacy.selfreply" xmlns="http://www.woltlab.com" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.woltlab.com http://www.woltlab.com/XSD/6.0/package.xsd">
	<packageinformation>
		<packagename>GWLegacy Trading Board Tools</packagename>
		<packagename language="fr">GWLegacy · Outils pour boards de vente</packagename>
		<packagedescription>Per-board tools for trading boards: prevent thread authors from replying to their own thread, give them a rate-limited bump button instead, and let them squash old replies when relisting.</packagedescription>
		<packagedescription language="fr">Outils par board pour les forums de vente : empêche l'auteur de répondre à son propre sujet, lui donne un bouton de bump limité à la place, et lui permet de masquer les anciennes réponses lors d'un relisting.</packagedescription>
		<version>1.1.3</version>
		<date>2026-06-16</date>
	</packageinformation>

	<authorinformation>
		<author>Calin</author>
		<authorurl>https://guildwarslegacy.com</authorurl>
	</authorinformation>

	<requiredpackages>
		<requiredpackage minversion="6.0.0">com.woltlab.wcf</requiredpackage>
		<requiredpackage minversion="6.0.0">com.woltlab.wbb</requiredpackage>
	</requiredpackages>

	<instructions type="install">
