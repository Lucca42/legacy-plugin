<?xml version="1.0" encoding="UTF-8"?>
<data xmlns="http://www.woltlab.com" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.woltlab.com http://www.woltlab.com/XSD/6.0/templateListener.xsd">
	<import>
		<!-- Per-board settings on the board ACP form. The dataFields event is emitted in
		     more than one place, so a shared render guard keeps the fields to one copy. -->
		<templatelistener name="lifecycleBoardSettings">
			<environment>admin</environment>
			<templatename>boardAdd</templatename>
			<eventname>dataFields</eventname>
			<templatecode><![CDATA[{if $gwLifecycleGuard|isset && $gwLifecycleGuard->renderOnce()}{include file='__gwLifecycleBoardOptions'}{/if}]]></templatecode>
		</templatelistener>

		<!-- Self-close button on the thread page. -->
		<templatelistener name="selfCloseButton">
			<environment>user</environment>
			<templatename>contentInteraction</templatename>
			<eventname>afterButtons</eventname>
			<templatecode><![CDATA[{if $gwCanSelfClose|isset}{include file='__gwSelfCloseButton'}{/if}]]></templatecode>
		</templatelistener>
	</import>
</data>
