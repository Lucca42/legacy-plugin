<?xml version="1.0" encoding="UTF-8"?>
<data xmlns="http://www.woltlab.com" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.woltlab.com http://www.woltlab.com/XSD/6.0/eventListener.xsd">
	<import>
		<!-- Retract button state on the thread page. -->
		<eventlistener name="retractDisplay">
			<eventclassname>wbb\page\ThreadPage</eventclassname>
			<eventname>assignVariables</eventname>
			<listenerclassname>wcf\system\event\listener\GwRetractDisplayListener</listenerclassname>
			<environment>user</environment>
		</eventlistener>

		<!-- Lock replies against editing (both opening the editor and saving). -->
		<eventlistener name="lockRepliesBeginEdit">
			<eventclassname>wbb\data\post\PostAction</eventclassname>
			<eventname>validateBeginEdit</eventname>
			<listenerclassname>wcf\system\event\listener\GwLockRepliesListener</listenerclassname>
			<environment>user</environment>
		</eventlistener>
		<eventlistener name="lockRepliesSave">
			<eventclassname>wbb\data\post\PostAction</eventclassname>
			<eventname>validateSave</eventname>
			<listenerclassname>wcf\system\event\listener\GwLockRepliesListener</listenerclassname>
			<environment>user</environment>
		</eventlistener>

		<!-- Per-board options on the board ACP form (read / save / prefill / display). -->
		<eventlistener name="retractBoardRead">
			<eventclassname>wbb\acp\form\BoardAddForm</eventclassname>
			<eventname>readFormParameters</eventname>
			<listenerclassname>wcf\system\event\listener\GwRetractBoardOptionListener</listenerclassname>
			<environment>admin</environment>
			<inherit>1</inherit>
		</eventlistener>
		<eventlistener name="retractBoardSave">
			<eventclassname>wbb\acp\form\BoardAddForm</eventclassname>
			<eventname>save</eventname>
			<listenerclassname>wcf\system\event\listener\GwRetractBoardOptionListener</listenerclassname>
			<environment>admin</environment>
			<inherit>1</inherit>
		</eventlistener>
		<eventlistener name="retractBoardAssign">
			<eventclassname>wbb\acp\form\BoardAddForm</eventclassname>
			<eventname>assignVariables</eventname>
			<listenerclassname>wcf\system\event\listener\GwRetractBoardOptionListener</listenerclassname>
			<environment>admin</environment>
			<inherit>1</inherit>
		</eventlistener>
		<eventlistener name="retractBoardReadData">
			<eventclassname>wbb\acp\form\BoardEditForm</eventclassname>
			<eventname>readData</eventname>
			<listenerclassname>wcf\system\event\listener\GwRetractBoardOptionListener</listenerclassname>
			<environment>admin</environment>
		</eventlistener>
	</import>
</data>
